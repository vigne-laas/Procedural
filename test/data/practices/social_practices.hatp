        "General assistance practice";
    }
    COMPETENCES {
        "task_planning";
        "object_manipulation";
    }
    OBJECTS {
        "task_objects";
    }
    ACTIVATION_CONDITIONS {
        "assistance_requested";
    }
    ROLES {
        "assistant_role";
    }
}