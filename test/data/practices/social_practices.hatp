PRACTICE Greet {
    DESCRIPTION {
        "Social greeting practice for human-robot interaction";
    }
    COMPETENCES {
        "social_interaction";
        "speech_synthesis";
    }
    OBJECTS {
        "human";
        "greeting_gesture";
    }
    ACTIVATION_CONDITIONS {
        "human detected";
        "social_context active";
    }
    ROLES {
        "greeter_role";
    }
}

PRACTICE Assistance {
