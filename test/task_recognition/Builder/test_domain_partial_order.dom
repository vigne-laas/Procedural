
HTN {

	// ----------------------------------------------

	task Test_Partial_Order(Agent A)
	{
	    goal{A.hasInRightHand == NULL;};
        {
            preconditions{};
            subtasks {
                1:Y(A, C1);
                2:Z(A, C2);
            };
        }
        {
            preconditions{};
            subtasks {
                1: A(A);
                2: B(A);
                3: C(A)>1;
                4: D(A)>1,>3;
                5: E(A)>4;
            };
        }
        {
            preconditions{};
            subtasks {
                F = SELECT(Whisk, {F.isReachable == A;});
                1:A(A,I);
                2:B(A,I,C)>1;
                3:C(A,F);
                4:D(A,F,C)>2,>3;
            };
        }
        {
            preconditions{A.inIn == Kitchen;};
            subtasks{
                1: A(A);
                2: B(A);
                3: C(A);
            };

        }
    }



}

// ----------------------------------------------

timePart { priority = 0; }

